APP_NAME=软件开发管理平台
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ===== PingCode 同步（开发中心「同步任务」用；未配置时该按钮会提示未配置）=====
# 在 PingCode 管理后台创建应用后填写；留空则功能不可用（不影响其它功能）
PINGCODE_CLIENT_ID=
PINGCODE_CLIENT_SECRET=
PINGCODE_PROJECT_ID=
# 项目可填 ID 或名称（如：快工单）；同步固定创建「史诗」类型工作项

# ===== 天气（输单登记页右侧「今天」卡片；Open-Meteo 免费无需 key）=====
# 填写城市名（中文即可，如：滕州 / 济南；Open-Meteo 能按县级市解析）；留空则页面不显示天气
WEATHER_CITY=
